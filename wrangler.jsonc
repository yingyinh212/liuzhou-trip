{
  "name": "liuzhou-trip",
  "compatibility_date": "2026-11-01",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TRIP_CHECKLIST", "class_name": "TripChecklist" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TripChecklist"] }
  ]
}
